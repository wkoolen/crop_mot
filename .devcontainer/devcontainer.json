{
  "name": "crop-mot (phase 1, no ROS)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  // workspaceMount must be explicit: without it Dev Containers mounts the repo at
  // /workspaces/<folder-name>, leaving /workspace (and PYTHONPATH) pointing at an empty dir.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // remoteUser is UID 1000 and must match your WSL distro user's `id -u`, or files created
  // in the container will be owned by the wrong user on the host. Unlike a Windows bind
  // mount, a WSL2 Linux bind mount carries real UIDs, so this matters.
  "remoteUser": "dev",

  // The repo lives in the WSL2 Linux filesystem, so the bind mount above is a native
  // Linux path at full speed (not a slow /mnt/c path).

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "shalldie.background",
        "Anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  },

  // Collect-only proves the wiring imports cleanly without running any NotImplementedError.
  "postCreateCommand": "python3 -m pytest tests -q --collect-only"
}
