# Force LF everywhere rather than relying on core.autocrlf, so a checkout on Windows and a
# build inside the Linux container see byte-identical files. With the repo living in the
# WSL2 filesystem this is belt-and-braces, but it matters the moment the repo is cloned on
# a Windows host - by you on another machine, or by a supervisor.
* text=auto eol=lf

*.py         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.jsonl      text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.toml       text eol=lf
*.sh         text eol=lf
Dockerfile   text eol=lf
.gitignore   text eol=lf
.dockerignore text eol=lf

# Binaries: never munge these.
*.png   binary
*.jpg   binary
*.gif   binary
*.pdf   binary
*.pptx  binary
*.drawio binary
*.npz   binary
*.npy   binary

# Related rule enforced by design rather than by git: there are NO executable shell scripts
# used as entry points. Everything runs via `python3 -m crop_mot ...`, because Windows bind
# mounts cannot express the exec bit and `git update-index --chmod` drift is a recurring
# annoyance on a cross-platform repo.
